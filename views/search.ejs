<%- include("partials/header", { title: "Search Cat Breeds" }) %>

<section class="page-hero">

    <div class="page-hero-inner">

        <p class="eyebrow eyebrow--light">Find Yours</p>

        <h1>🔍 Search Cat Breeds</h1>

        <p>Find your favorite cat breed by name, origin, temperament, coat type, or grooming level.</p>

    </div>

</section>

<div class="content-section">

<div class="row justify-content-center mb-5">

    <div class="col-lg-8">

        <form action="/search" method="GET">

            <div class="input-group input-group-lg shadow-sm">

                <input
                    type="text"
                    name="q"
                    class="form-control"
                    placeholder="Try: Persian, Canada, Friendly..."
                    value="<%= req.query.q || '' %>">

                <button
                    class="btn btn-primary px-4"
                    type="submit">

                    🔍 Search

                </button>

            </div>

        </form>

    </div>

</div>

<% if (typeof breeds !== "undefined") { %>

    <% if (breeds.length === 0) { %>

        <div class="text-center py-5">

            <div style="font-size:70px;">😿</div>

            <h2 class="fw-bold mt-3">

                No Breeds Found

            </h2>

            <p class="text-muted">

                We couldn't find any breeds matching your search.

            </p>

            <a href="/breeds" class="btn btn-primary">

                Browse All Breeds

            </a>

        </div>

    <% } else { %>

        <div class="mb-4">

            <h4>

                <strong><%= breeds.length %></strong>

                breed<%= breeds.length !== 1 ? "s" : "" %> found

            </h4>

        </div>

        <div class="row g-4">

            <% breeds.forEach((breed) => { %>

                <div class="col-lg-4 col-md-6">

                    <div class="card breed-card h-100">

                        <div class="image-wrapper">

                            <img
                                src="<%= breed.imageUrl %>"
                                class="card-img-top"
                                alt="<%= breed.name %>">

                        </div>

                        <div class="card-body d-flex flex-column">

                            <h4 class="fw-bold">

                                <%= breed.name %>

                            </h4>

                            <p class="text-primary fw-semibold">

                                🌍 <%= breed.origin %>

                            </p>

                            <p class="text-muted">

                                <%= breed.description.length > 110
                                    ? breed.description.substring(0,110) + "..."
                                    : breed.description %>

                            </p>

                            <% if (breed.tags && breed.tags.length) { %>

                                <div class="mt-auto mb-3">

                                    <% breed.tags.forEach(tag => { %>

                                        <span class="tag">

                                            <%= tag %>

                                        </span>

                                    <% }) %>

                                </div>

                            <% } %>

                        </div>

                        <div class="card-footer">

                            <div class="d-grid gap-2">

                                <a
                                    href="/breeds/<%= breed.id %>"
                                    class="btn btn-primary">

                                    View Details

                                </a>

                                <a
                                    href="/breeds/<%= breed.id %>/edit"
                                    class="btn btn-warning">

                                    Edit Breed

                                </a>

                            </div>

                        </div>

                    </div>

                </div>

            <% }) %>

        </div>

    <% } %>

<% } %>

</div>

<%- include("partials/footer") %>