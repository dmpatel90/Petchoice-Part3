<%- include("partials/header", { title: "Admin Dashboard" }) %>

<section class="page-hero">

    <div class="page-hero-inner">

        <p class="eyebrow eyebrow--light">Admin Only</p>

        <h1>Admin Dashboard</h1>

        <p>An overview of Pet Choice users, breeds, and catalog activity.</p>

    </div>

</section>

<section class="content-section">

    <div class="dashboard-stats">

        <div class="dashboard-stat">
            <div class="dashboard-stat-value"><%= totalBreeds %></div>
            <div class="dashboard-stat-label">🐱 Total Breeds</div>
        </div>

        <div class="dashboard-stat">
            <div class="dashboard-stat-value"><%= totalUsers %></div>
            <div class="dashboard-stat-label">👤 Total Users</div>
        </div>

        <div class="dashboard-stat">
            <div class="dashboard-stat-value"><%= totalAdmins %> / <%= totalViewers %></div>
            <div class="dashboard-stat-label">🛡️ Admins / Viewers</div>
        </div>

    </div>

</section>

<section class="content-section">

    <div class="row g-4">

        <div class="col-lg-6">

            <div class="form-card">

                <h2 class="h4 mb-3">Top Origins</h2>

                <% if (!originRows || originRows.length === 0) { %>

                    <p class="text-muted mb-0">No breed data yet.</p>

                <% } else { %>

                    <table class="table">

                        <thead>
                            <tr>
                                <th>Origin</th>
                                <th>Breeds</th>
                            </tr>
                        </thead>

                        <tbody>

                            <% originRows.forEach(row => { %>

                                <tr>
                                    <td><%= row.origin %></td>
                                    <td><%= row.count %></td>
                                </tr>

                            <% }) %>

                        </tbody>

                    </table>

                <% } %>

            </div>

        </div>

        <div class="col-lg-6">

            <div class="form-card">

                <h2 class="h4 mb-3">Recently Added Breeds</h2>

                <% if (!recentBreeds || recentBreeds.length === 0) { %>

                    <p class="text-muted mb-0">No breeds yet.</p>

                <% } else { %>

                    <ul class="list-unstyled mb-0">

                        <% recentBreeds.forEach(b => { %>

                            <li class="mb-2">
                                <a href="/breeds/<%= b.id %>"><%= b.name %></a>
                                <span class="text-muted">— <%= b.origin %></span>
                            </li>

                        <% }) %>

                    </ul>

                <% } %>

            </div>

        </div>

    </div>

    <div class="form-card mt-4">

        <h2 class="h4 mb-3">User Accounts</h2>

        <table class="table mb-0">

            <thead>
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Role</th>
                </tr>
            </thead>

            <tbody>

                <% users.forEach(u => { %>

                    <tr>
                        <td><%= u.name %></td>
                        <td><%= u.email %></td>
                        <td>
                            <span class="badge <%= u.role === 'admin' ? 'text-bg-warning' : 'text-bg-secondary' %>">
                                <%= u.role %>
                            </span>
                        </td>
                    </tr>

                <% }) %>

            </tbody>

        </table>

    </div>

</section>

<%- include("partials/footer") %>
