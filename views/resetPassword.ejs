<%- include("partials/header", { title: "Reset Password" }) %>

<section class="page-hero">

    <div class="page-hero-inner">

        <p class="eyebrow eyebrow--light">Account Recovery</p>

        <h1>Choose a new password</h1>

        <p>You're verified — set a new password for your account.</p>

    </div>

</section>

<div class="content-section">

    <div class="row justify-content-center">

        <div class="col-lg-6 col-md-8">

            <div class="form-card">

                <div class="text-center mb-4">

                    <p class="eyebrow">Step 3 of 3</p>

                    <h1 class="display-6 fw-bold">🔒 Reset Password</h1>

                    <p class="text-muted">Enter and confirm your new password.</p>

                </div>

                <% if (typeof error !== 'undefined' && error) { %>
                    <div class="alert alert-danger" role="alert"><%= error %></div>
                <% } %>

                <form action="/reset-password" method="POST">

                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                    <div class="mb-4">

                        <label class="form-label">New Password <span class="required">*</span></label>

                        <input
                            type="password"
                            name="newPassword"
                            class="form-control"
                            minlength="8"
                            required>

                        <small class="text-muted">Minimum 8 characters.</small>

                    </div>

                    <div class="mb-4">

                        <label class="form-label">Confirm New Password <span class="required">*</span></label>

                        <input
                            type="password"
                            name="confirmPassword"
                            class="form-control"
                            minlength="8"
                            required>

                    </div>

                    <div class="form-actions">

                        <button type="submit" class="btn btn-primary">Reset Password</button>

                        <a href="/login" class="btn btn-outline-secondary">Cancel</a>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>

<%- include("partials/footer") %>
