<%- include("partials/header", { title: breed.name }) %>

<div class="row align-items-center g-5">

    <div class="col-lg-5">

        <img
            src="<%= breed.imageUrl %>"
            class="img-fluid breed-details-image"
            alt="<%= breed.name %>">

    </div>

    <div class="col-lg-7">

        <p class="eyebrow">Breed Profile</p>

        <h1 class="display-4 fw-bold">

            <%= breed.name %>

        </h1>

        <p class="lead text-primary fw-semibold">

            🌍 <%= breed.origin %>

        </p>

        <p class="mt-4">

            <%= breed.description %>

        </p>

        <hr>

        <div class="row g-3">

            <div class="col-md-6">

                <div class="info-card">

                    <h6>🐾 Temperament</h6>

                    <p><%= breed.temperament %></p>

                </div>

            </div>

            <div class="col-md-6">

                <div class="info-card">

                    <h6>⏳ Lifespan</h6>

                    <p><%= breed.lifespan %></p>

                </div>

            </div>

            <div class="col-md-6">

                <div class="info-card">

                    <h6>⚖ Weight</h6>

                    <p><%= breed.weight %></p>

                </div>

            </div>

            <div class="col-md-6">

                <div class="info-card">

                    <h6>🧶 Coat Type</h6>

                    <p><%= breed.coatType %></p>

                </div>

            </div>

            <div class="col-md-6">

                <div class="info-card">

                    <h6>🪮 Grooming</h6>

                    <p><%= breed.groomingLevel %></p>

                </div>

            </div>

        </div>

        <% if (breed.tags && breed.tags.length) { %>

        <div class="mt-4">

            <h5 class="mb-3">

                Tags

            </h5>

            <% breed.tags.forEach(tag => { %>

                <span class="tag">

                    <%= tag %>

                </span>

            <% }) %>

        </div>

        <% } %>

        <div class="mt-5 d-flex flex-wrap gap-3">

            <a
                href="/breeds"
                class="btn btn-secondary">

                ← Back

            </a>

            <a
                href="/breeds/<%= breed.id %>/edit"
                class="btn btn-warning">

                Edit Breed

            </a>

            <form
                action="/breeds/<%= breed.id %>/delete"
                method="POST">

                <button
                    class="btn btn-danger"
                    onclick="return confirm('Delete this breed?')">

                    Delete Breed

                </button>

            </form>

        </div>

    </div>

</div>

<%- include("partials/footer") %>