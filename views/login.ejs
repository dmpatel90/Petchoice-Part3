<%- include("partials/header", { title: "Login" }) %>

<section class="page-hero">

    <div class="page-hero-inner">

        <p class="eyebrow eyebrow--light">Welcome back</p>

        <h1>Sign in to Pet Choice</h1>

        <p>Log in to browse the full breed catalog and manage records.</p>

    </div>

</section>

<div class="content-section">

    <div class="row justify-content-center">

        <div class="col-lg-6 col-md-8">

            <div class="form-card">

                <div class="text-center mb-4">

                    <p class="eyebrow">Account Access</p>

                    <h1 class="display-6 fw-bold">🐾 Login</h1>

                    <p class="text-muted">Enter your credentials to continue.</p>

                </div>

                <% if (typeof error !== 'undefined' && error) { %>
                    <div class="alert alert-danger" role="alert"><%= error %></div>
                <% } %>

                <% if (typeof success !== 'undefined' && success) { %>
                    <div class="alert alert-success" role="alert"><%= success %></div>
                <% } %>

                <form action="/login" method="POST">

                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                    <div class="mb-4">

                        <label class="form-label">Email <span class="required">*</span></label>

                        <input
                            type="email"
                            name="email"
                            class="form-control"
                            placeholder="you@example.com"
                            required>

                    </div>

                    <div class="mb-4">

                        <label class="form-label">Password <span class="required">*</span></label>

                        <input
                            type="password"
                            name="password"
                            class="form-control"
                            placeholder="••••••••"
                            required>

                    </div>

                    <div class="form-actions">

                        <button type="submit" class="btn btn-primary">Login</button>

                        <a href="/" class="btn btn-outline-secondary">Cancel</a>

                    </div>

                </form>

                <div class="text-center mt-4">

                    <p class="mb-1"><a href="/forgot-password">Forgot your password?</a></p>

                    <p class="mb-0">New here? <a href="/register">Create an account</a></p>

                </div>

            </div>

        </div>

    </div>

</div>

<%- include("partials/footer") %>
