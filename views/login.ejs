<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - Pet Choice</title>

    <link rel="stylesheet" href="/css/style.css">

    <style>
        .login-container{
            max-width:450px;
            margin:60px auto;
            padding:30px;
            border:1px solid #ddd;
            border-radius:10px;
            background:#fff;
        }

        input{
            width:100%;
            padding:10px;
            margin-bottom:15px;
        }

        button{
            width:100%;
            padding:10px;
            cursor:pointer;
        }
    </style>
</head>
<body>

<div class="login-container">

    <h2>Login</h2>

    <% if(typeof error !== 'undefined'){ %>
        <p style="color:red;"><%= error %></p>
    <% } %>

    <form action="/login" method="POST">

        <label>Email</label>

        <input
            type="email"
            name="email"
            required
        >

        <label>Password</label>

        <input
            type="password"
            name="password"
            required
        >

        <button type="submit">
            Login
        </button>

    </form>

</div>

</body>
</html>