<%- include("partials/header", { title: "Forgot Password" }) %>

<section class="page-hero">

    <div class="page-hero-inner">

        <p class="eyebrow eyebrow--light">Account Recovery</p>

        <h1>Forgot your password?</h1>

        <p>Enter your account email and we'll send you a one-time verification code.</p>

    </div>

</section>

<div class="content-section">

    <div class="row justify-content-center">

        <div class="col-lg-6 col-md-8">

            <div class="form-card">

                <div class="text-center mb-4">

                    <p class="eyebrow">Step 1 of 3</p>

                    <h1 class="display-6 fw-bold">🔑 Reset Password</h1>

                    <p class="text-muted">We'll send a 6-digit code to verify it's you.</p>

                </div>

                <% if (typeof error !== 'undefined' && error) { %>
                    <div class="alert alert-danger" role="alert"><%= error %></div>
                <% } %>

                <form action="/forgot-password" method="POST">

                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                    <div class="mb-4">

                        <label class="form-label">Email <span class="required">*</span></label>

                        <input
                            type="email"
                            name="email"
                            class="form-control"
                            placeholder="you@example.com"
                            required>

                    </div>

                    <div class="form-actions">

                        <button type="submit" class="btn btn-primary">Send Verification Code</button>

                        <a href="/login" class="btn btn-outline-secondary">Cancel</a>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>

<%- include("partials/footer") %>
