<ul class="nav-links">

    <li>
        <a href="/" class="<%= typeof req !== 'undefined' && req.path === '/' ? 'active' : '' %>">
            Home
        </a>
    </li>

    <li>
        <a href="/breeds" class="<%= typeof req !== 'undefined' && req.path.startsWith('/breeds') && req.path !== '/breeds/add' ? 'active' : '' %>">
            Breed Catalog
        </a>
    </li>

    <% if (user && user.role === "admin") { %>

        <li>
            <a href="/breeds/add" class="<%= typeof req !== 'undefined' && req.path === '/breeds/add' ? 'active' : '' %>">
                Add Breed
            </a>
        </li>

        <li>
            <a href="/admin/dashboard" class="<%= typeof req !== 'undefined' && req.path === '/admin/dashboard' ? 'active' : '' %>">
                Dashboard
            </a>
        </li>

    <% } %>

    <li>
        <a href="/search" class="<%= typeof req !== 'undefined' && req.path === '/search' ? 'active' : '' %>">
            Search
        </a>
    </li>

    <li>
        <a href="/about" class="<%= typeof req !== 'undefined' && req.path === '/about' ? 'active' : '' %>">
            About
        </a>
    </li>

    <% if (user) { %>

        <li>
            <a href="/change-password" class="<%= typeof req !== 'undefined' && req.path === '/change-password' ? 'active' : '' %>">
                Change Password
            </a>
        </li>

        <li>
            <span class="nav-user">
                👋 <%= user.name %> (<%= user.role %>)
            </span>
        </li>

        <li>
            <a href="/logout">
                Logout
            </a>
        </li>

    <% } else { %>

        <li>
            <a href="/register" class="<%= typeof req !== 'undefined' && req.path === '/register' ? 'active' : '' %>">
                Register
            </a>
        </li>

        <li>
            <a href="/login" class="<%= typeof req !== 'undefined' && req.path === '/login' ? 'active' : '' %>">
                Login
            </a>
        </li>

    <% } %>

</ul>