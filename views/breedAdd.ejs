<%- include("partials/header", { title: "Add Breed" }) %>

<div class="row justify-content-center">

    <div class="col-xl-8 col-lg-9">

        <div class="form-card">

            <div class="text-center mb-5">

                <h1 class="display-5 fw-bold">

                    ➕ Add New Cat Breed

                </h1>

                <p class="text-muted">

                    Fill in the details below to add a new breed to the PetChoice database.

                </p>

            </div>

            <form action="/breeds/add" method="POST">

                <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                <div class="row">

                    <div class="col-md-6 mb-4">

                        <label class="form-label">

                            Breed ID <span class="required">*</span>

                        </label>

                        <input
                            type="text"
                            name="id"
                            class="form-control"
                            placeholder="breed-031"
                            required>

                    </div>

                    <div class="col-md-6 mb-4">

                        <label class="form-label">

                            Breed Name <span class="required">*</span>

                        </label>

                        <input
                            type="text"
                            name="name"
                            class="form-control"
                            placeholder="Persian"
                            required>

                    </div>

                </div>

                <div class="row">

                    <div class="col-md-6 mb-4">

                        <label class="form-label">

                            Origin <span class="required">*</span>

                        </label>

                        <input
                            type="text"
                            name="origin"
                            class="form-control"
                            placeholder="Iran"
                            required>

                    </div>

                    <div class="col-md-6 mb-4">

                        <label class="form-label">

                            Image URL <span class="required">*</span>

                        </label>

                        <input
                            type="url"
                            name="imageUrl"
                            class="form-control"
                            placeholder="https://example.com/cat.jpg"
                            required>

                    </div>

                </div>

                <div class="mb-4">

                    <label class="form-label">

                        Temperament <span class="required">*</span>

                    </label>

                    <textarea
                        name="temperament"
                        class="form-control"
                        rows="3"
                        placeholder="Friendly, Calm, Playful..."
                        required></textarea>

                </div>

                <div class="mb-4">

                    <label class="form-label">

                        Description <span class="required">*</span>

                    </label>

                    <textarea
                        name="description"
                        class="form-control"
                        rows="5"
                        placeholder="Write a short description about this breed..."
                        required></textarea>

                </div>

                <div class="row">

                    <div class="col-md-4 mb-4">

                        <label class="form-label">

                            Lifespan <span class="required">*</span>

                        </label>

                        <input
                            type="text"
                            name="lifespan"
                            class="form-control"
                            placeholder="12 - 16 years"
                            required>

                    </div>

                    <div class="col-md-4 mb-4">

                        <label class="form-label">

                            Weight <span class="required">*</span>

                        </label>

                        <input
                            type="text"
                            name="weight"
                            class="form-control"
                            placeholder="8 - 15 lbs"
                            required>

                    </div>

                    <div class="col-md-4 mb-4">

                        <label class="form-label">

                            Coat Type <span class="required">*</span>

                        </label>

                        <input
                            type="text"
                            name="coatType"
                            class="form-control"
                            placeholder="Short"
                            required>

                    </div>

                </div>

                <div class="row">

                    <div class="col-md-6 mb-4">

                        <label class="form-label">

                            Grooming Level

                        </label>

                        <select
                            name="groomingLevel"
                            class="form-select">

                            <option>Low</option>
                            <option>Medium</option>
                            <option>High</option>

                        </select>

                    </div>

                    <div class="col-md-6 mb-4">

                        <label class="form-label">

                            Tags

                        </label>

                        <input
                            type="text"
                            name="tags"
                            class="form-control"
                            placeholder="Friendly, Active, Intelligent">

                    </div>

                </div>

                <div class="form-actions">

                    <button class="btn btn-primary">

                        💾 Save Breed

                    </button>

                    <a
                        href="/breeds"
                        class="btn btn-outline-secondary">

                        Cancel

                    </a>

                </div>

            </form>

        </div>

    </div>

</div>

<%- include("partials/footer") %>