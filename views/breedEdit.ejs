<%- include("partials/header", { title: "Edit Breed" }) %>

<div class="row justify-content-center">

    <div class="col-xl-8 col-lg-9">

        <div class="form-card">

            <div class="text-center mb-5">

                <h1 class="display-5 fw-bold">

                    ✏️ Edit Cat Breed

                </h1>

                <p class="text-muted">

                    Update the information below and save your changes.

                </p>

            </div>

            <form action="/breeds/<%= breed.id %>/edit" method="POST">

                <div class="row">

                    <div class="col-md-6 mb-4">

                        <label class="form-label">

                            Breed ID

                        </label>

                        <input
                            type="text"
                            class="form-control"
                            value="<%= breed.id %>"
                            readonly>

                    </div>

                    <div class="col-md-6 mb-4">

                        <label class="form-label">

                            Breed Name <span class="required">*</span>

                        </label>

                        <input
                            type="text"
                            name="name"
                            class="form-control"
                            value="<%= breed.name %>"
                            required>

                    </div>

                </div>

                <div class="row">

                    <div class="col-md-6 mb-4">

                        <label class="form-label">

                            Origin <span class="required">*</span>

                        </label>

                        <input
                            type="text"
                            name="origin"
                            class="form-control"
                            value="<%= breed.origin %>"
                            required>

                    </div>

                    <div class="col-md-6 mb-4">

                        <label class="form-label">

                            Image URL <span class="required">*</span>

                        </label>

                        <input
                            type="url"
                            name="imageUrl"
                            class="form-control"
                            value="<%= breed.imageUrl %>"
                            required>

                    </div>

                </div>

                <div class="mb-4">

                    <label class="form-label">

                        Temperament <span class="required">*</span>

                    </label>

                    <textarea
                        name="temperament"
                        rows="3"
                        class="form-control"
                        required><%= breed.temperament %></textarea>

                </div>

                <div class="mb-4">

                    <label class="form-label">

                        Description <span class="required">*</span>

                    </label>

                    <textarea
                        name="description"
                        rows="5"
                        class="form-control"
                        required><%= breed.description %></textarea>

                </div>

                <div class="row">

                    <div class="col-md-4 mb-4">

                        <label class="form-label">

                            Lifespan <span class="required">*</span>

                        </label>

                        <input
                            type="text"
                            name="lifespan"
                            class="form-control"
                            value="<%= breed.lifespan %>"
                            required>

                    </div>

                    <div class="col-md-4 mb-4">

                        <label class="form-label">

                            Weight <span class="required">*</span>

                        </label>

                        <input
                            type="text"
                            name="weight"
                            class="form-control"
                            value="<%= breed.weight %>"
                            required>

                    </div>

                    <div class="col-md-4 mb-4">

                        <label class="form-label">

                            Coat Type <span class="required">*</span>

                        </label>

                        <input
                            type="text"
                            name="coatType"
                            class="form-control"
                            value="<%= breed.coatType %>"
                            required>

                    </div>

                </div>

                <div class="row">

                    <div class="col-md-6 mb-4">

                        <label class="form-label">

                            Grooming Level

                        </label>

                        <select
                            name="groomingLevel"
                            class="form-select">

                            <option value="Low" <%= breed.groomingLevel === "Low" ? "selected" : "" %>>
                                Low
                            </option>

                            <option value="Medium" <%= breed.groomingLevel === "Medium" ? "selected" : "" %>>
                                Medium
                            </option>

                            <option value="High" <%= breed.groomingLevel === "High" ? "selected" : "" %>>
                                High
                            </option>

                        </select>

                    </div>

                    <div class="col-md-6 mb-4">

                        <label class="form-label">

                            Tags

                        </label>

                        <input
                            type="text"
                            name="tags"
                            class="form-control"
                            value="<%= breed.tags ? breed.tags.join(', ') : '' %>"
                            placeholder="Friendly, Calm, Intelligent">

                    </div>

                </div>

                <div class="form-actions">

                    <button class="btn btn-primary">

                        💾 Update Breed

                    </button>

                    <a
                        href="/breeds/<%= breed.id %>"
                        class="btn btn-outline-secondary">

                        Cancel

                    </a>

                </div>

            </form>

        </div>

    </div>

</div>

<%- include("partials/footer") %>